@Library("Shared")_
pipeline{
    agent { label "dev"}

    stages{
        stage("Clone"){
            steps {
              script{
                clone("https://github.com/MayurYCoder/two-tier-flask-app.git","master")
              }
            }
        }
        stage("trivy scan"){
            steps {
                trivy_fs()
                echo "✅ Trivy scan completed. Report saved as trivy_scan.json"
            }
        }

        stage("build image"){
            steps {
                sh "docker build -t two-tier-flask-app ."
            }
        }
         stage("Test"){
            steps {
                echo "Test cases passsed"
            }
        }
         stage("Push to docker hub"){
            steps {
               script{
                   docker_push("dockerHubCreds","two-tier-flask-app")
               }
            }
        }
        stage(" docker compose  image"){
            steps {
                sh "docker compose up -d --build flask-app "
            }
        }
    }
post {
        success {
            emailext(
                to: 'yadavm0205@gmail.com',
                subject: "✅ SUCCESS",
                body: """<p>Hello Team,</p>
                         <p>The Jenkins job <b>${env.JOB_NAME} #${env.BUILD_NUMBER}</b> has <b>SUCCEEDED</b>.</p>
                         <p>Check console output <a href="${env.BUILD_URL}">here</a>.</p>"""
            )
        }
        failure {
            emailext(
                to: 'yadavm0205@gmail.com',
                subject: "❌ FAILURE: Job ",
                body: """<p>Hello Team,</p>
                         <p>The Jenkins job <b>${env.JOB_NAME} #${env.BUILD_NUMBER}</b> has <b>FAILED</b>.</p>
                         <p>Please check the console output <a href="${env.BUILD_URL}">here</a> for details.</p>"""
            )
        }
        always {
            echo "Email notification process completed"
        }
    }
}
